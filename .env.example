# Copy to .env.local for development, or set these in Vercel's project settings.
# Every one of them is optional. With none set the site runs and serves the
# live feed; each one turns on a specific capability, and the app reports which
# are active rather than pretending.

# --- Shared feed cache (strongly recommended in production) -------------------
# Without this, each serverless instance keeps its own in-memory copy and every
# cold start re-scans all 38 employers. Vercel KV sets the KV_* pair for you when
# you attach the integration; Upstash uses the UPSTASH_* names. Either works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Postgres (enables sighting history and email alerts) ---------------------
# Any Postgres: Neon, Supabase, Vercel Postgres, RDS. Use the *pooled* connection
# string on serverless. Apply the schema with `npm run db:migrate`.
# Without it: posting ages fall back to what the employer reports, there is no
# "new since your last visit" badge or closed-role flag, and alerts stay off.
DATABASE_URL=

# --- Email alerts (also needs DATABASE_URL) -----------------------------------
# Without both of these, /api/alerts reports { enabled: false } and the UI hides
# the subscribe form rather than collecting addresses it could never mail.
RESEND_API_KEY=
ALERTS_FROM_EMAIL="NurseLaunch <alerts@yourdomain.com>"

# --- Scheduled digests --------------------------------------------------------
# Vercel sends this as a bearer token to /api/cron/digest on the schedule in
# vercel.json. The route refuses to run when it is unset, so a public URL cannot
# be used to mail your subscribers.
CRON_SECRET=
